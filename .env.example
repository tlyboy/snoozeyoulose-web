# 游戏版本号（用于拼接安装包文件名与 release tag v${版本}）
NEXT_PUBLIC_GAME_VERSION=0.0.0

# 下载源根地址。最终链接 = ${BASE}/v${版本}/${安装包文件名}
#   国际（默认）→ GitHub 公开 release：https://github.com/tlyboys/snoozeyoulose/releases/download
#   国内（可选）→ 阿里云 OSS 等扁平存储时，需去掉 lib/download.ts 中的 v${版本}/ 段
NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://github.com/tlyboys/snoozeyoulose/releases/download
